<Window x:Class="BEWebshop.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register" Height="400" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Register" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Email:" Margin="0,5"/>
        <TextBox Grid.Row="1" x:Name="EmailTextBox" Margin="0,25,0,0" Padding="5"/>

        <TextBlock Grid.Row="2" Text="Password:" Margin="0,15,0,5"/>
        <PasswordBox Grid.Row="2" x:Name="PasswordBox" Margin="0,40,0,0" Padding="5"/>

        <TextBlock Grid.Row="3" Text="Confirm Password:" Margin="0,15,0,5"/>
        <PasswordBox Grid.Row="3" x:Name="ConfirmPasswordBox" Margin="0,40,0,0" Padding="5"/>

        <Button Grid.Row="4" Content="Register" Click="RegisterButton_Click" 
                Margin="0,20,0,0" Padding="10" Background="#4CAF50" Foreground="White"/>

        <Button Grid.Row="5" Content="Cancel" Click="CancelButton_Click" 
                Margin="0,10,0,0" Padding="10"/>
    </Grid>
</Window>