<Window x:Class="BEWebshop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BEWebshop"
        xmlns:views="clr-namespace:BEWebshop.Views"
        mc:Ignorable="d"
        Title="BE Webshop" Height="600" Width="1000" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:ViewToColorConverter x:Key="ViewToColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navigation Bar -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Products" Command="{Binding NavigateToProductsCommand}" 
                        Width="120" Height="35" Margin="5"
                        Background="{Binding CurrentView, Converter={StaticResource ViewToColorConverter}, ConverterParameter=Products}"/>
                <Button Content="Shopping Cart" Command="{Binding NavigateToCartCommand}" 
                        Width="120" Height="35" Margin="5"
                        Background="{Binding CurrentView, Converter={StaticResource ViewToColorConverter}, ConverterParameter=Cart}"/>
                <Button Content="Orders" Command="{Binding NavigateToOrdersCommand}" 
                        Width="120" Height="35" Margin="5"
                        Background="{Binding CurrentView, Converter={StaticResource ViewToColorConverter}, ConverterParameter=Orders}"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- ProductView -->
            <views:ProductView DataContext="{Binding ProductViewModel}">
                <views:ProductView.Style>
                    <Style TargetType="views:ProductView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Products">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:ProductView.Style>
            </views:ProductView>

            <!-- CartView -->
            <views:CartView DataContext="{Binding CartViewModel}">
                <views:CartView.Style>
                    <Style TargetType="views:CartView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Cart">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:CartView.Style>
            </views:CartView>

            <!-- OrderView -->
            <views:OrderView DataContext="{Binding OrderViewModel}">
                <views:OrderView.Style>
                    <Style TargetType="views:OrderView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Orders">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:OrderView.Style>
            </views:OrderView>
        </Grid>
    </Grid>
</Window>
